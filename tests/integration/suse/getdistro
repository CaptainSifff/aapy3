#!/bin/sh
# Test adapter for the small getdistro output contract used by globals.aap.
set -eu

version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"')
major=${version%%.*}
minor=${version#*.}
if [ "$minor" = "$version" ]; then
  minor=0
fi

case "${1-}" in
  '') printf '%s\n' suse ;;
  -v) printf 'SUSE%s\n' "$major" ;;
  -vv) printf 'SUSE %s %s\n' "$major" "$minor" ;;
  *) exit 2 ;;
esac
